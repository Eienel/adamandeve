# --- Chain ---
# Local anvil (default) or Arc testnet: https://rpc.testnet.arc.network
RPC_URL=http://127.0.0.1:8545

# Resolver/deployer key (anvil account #0 shown; NEVER use a real key here)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployments written here by scripts/deploy-local.sh
DEPLOYMENTS_FILE=./deployments.local.json

# --- Agents ---
# Number of agents in the fleet
FLEET_SIZE=3
# Model provider (pick ONE). With none set, agents use deterministic heuristic strategies.
# Provider order if multiple are set: Gemini -> Bedrock/Anthropic.
#
# Option A: Google Gemini (preferred — free tier + Google Search grounding for live news/sentiment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Option B: direct Anthropic API
ANTHROPIC_API_KEY=
# Option C: AWS Bedrock (Claude via Bedrock). The bearer token is the "ABSK..." API key.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
#
# Claude model id (Options B/C). Anthropic: claude-haiku-4-5-20251001 | Bedrock: us.anthropic.claude-3-5-haiku-20241022-v1:0
AGENT_MODEL=

# --- Circle (only for live Arc deployment of agent wallets) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- API / dashboard ---
PORT=8787
# Shared local data file (reasoning traces, signal purchases)
ARENA_DATA_FILE=./arena-data.json

# --- Display name (project name kept out of the repo for now) ---
APP_NAME=Untitled
